@Library('jenkins-shared-library') _

pipeline {
    agent {
        label 'linux-agent'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = 'alshaimaamo/demoapp'
        DOCKER_CREDENTIALS_ID = 'dockerhub-credentials'
        K8S_NAMESPACE = 'ivolve'
        K8S_DEPLOYMENT = 'demoapp-lab21'
        K8S_MANIFEST = 'CI-CD/lab22-jenkins-shared-libraries/k8s/deployment.yaml'
    }

    stages {
        stage('Checkout DemoApp') {
            steps {
                dir('DemoApp') {
                    git branch: 'main',
                        url: 'https://github.com/Ibrahim-Adel15/DemoApp.git'
                }
            }
        }

        stage('BuildApp') {
            steps {
                dir('DemoApp') {
                    script {
                        BuildApp(pomFile: 'pom.xml')
                    }
                }
            }
        }

        stage('BuildImage') {
            steps {
                dir('DemoApp') {
                    script {
                        BuildImage(
                            imageName: env.DOCKER_IMAGE,
                            imageTag: env.BUILD_NUMBER,
                            credentialsId: env.DOCKER_CREDENTIALS_ID
                        )
                    }
                }
            }
        }

        stage('DeployOnK8s') {
            steps {
                script {
                    DeployOnK8s(
                        image: "${env.DOCKER_IMAGE}:${env.BUILD_NUMBER}",
                        manifest: env.K8S_MANIFEST,
                        namespace: env.K8S_NAMESPACE,
                        deployment: env.K8S_DEPLOYMENT
                    )
                }
            }
        }
    }

    post {
        success {
            echo 'Lab 22 pipeline completed successfully!'
        }
        failure {
            echo 'Lab 22 pipeline failed. Check the stage logs.'
        }
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
